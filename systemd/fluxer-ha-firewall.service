# fluxer-ha: rendered by `fluxer-ha install` (@FLUXER_DIR@, @WG_UNIT@, @RUN_USER@).
# Runs as @RUN_USER@ with CAP_NET_ADMIN, the one capability iptables needs;
# the only fluxer-ha service with any privilege.
# The DOCKER-USER rules that keep the witness, the LAN and anything else that
# isn't the peer site away from Postgres, Patroni, Valkey, S3 and the filer.
# Re-applied whenever Docker restarts; fluxer-ha-firewall-check.timer checks
# them every 30 s.
[Unit]
Description=Fluxer HA firewall (WireGuard -> Docker-published ports)
Requires=docker.service
After=docker.service @WG_UNIT@
PartOf=docker.service
Before=fluxer-ha-controller.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/lib/fluxer-ha/firewall.sh apply
ExecStartPost=/usr/local/lib/fluxer-ha/firewall.sh ensure
ExecStop=/usr/local/lib/fluxer-ha/firewall.sh remove

# iptables needs CAP_NET_ADMIN and nothing else (lab: create, change and
# delete a chain as the Fluxer user with only that capability), so the
# firewall runs as that user with that one capability, not as root.
User=@RUN_USER@
# Sandboxing (docs/security.md, "What runs as root"). The Docker socket is
# this service's job, so it stays reachable, and with it everything Docker can
# do; these settings take away the rest: no setuid, no capabilities, no kernel
# tunables or modules, /usr and /etc read-only, a private /tmp.
NoNewPrivileges=yes
RestrictSUIDSGID=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=full
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
UMask=0027
CapabilityBoundingSet=CAP_NET_ADMIN
AmbientCapabilities=CAP_NET_ADMIN
[Install]
WantedBy=multi-user.target docker.service
