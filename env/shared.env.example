# fluxer-ha: the HA block of .env.shared. `fluxer-ha init` writes it for you
# (with fresh secrets) after the settings your instance already has; this file
# documents every key. .env.shared must be BYTE-IDENTICAL on both sites.
#
# Never regenerate an existing Fluxer secret (POSTGRES_PASSWORD, the VAPID
# keys, the media proxy keys, ...): passkeys, web push, signed media URLs and
# sessions depend on both sites holding the same values.

# --- Cluster membership (WireGuard addresses) ---
FLUXER_HA_ETCD_HOSTS=10.77.0.1:2379,10.77.0.2:2379,10.77.0.3:2379
FLUXER_HA_ETCD_INITIAL_CLUSTER=site1=http://10.77.0.1:2380,site2=http://10.77.0.2:2380,witness=http://10.77.0.3:2380
FLUXER_HA_WITNESS_WG_IP=10.77.0.3
FLUXER_HA_WG_INTERFACE=wg0
# Extra holes, empty unless you need them: "ip:port,..." through the
# firewall, and ";"-separated pg_hba lines. Each one widens the boundary.
FLUXER_HA_FIREWALL_ALLOW=
FLUXER_HA_PG_HBA_EXTRA=

# --- Secrets (fluxer-ha init generates them; hex only) ---
FLUXER_HA_PG_SUPERUSER_PASSWORD=
FLUXER_HA_PG_REPLICATION_PASSWORD=
FLUXER_HA_PATRONI_API_PASSWORD=
FLUXER_HA_ETCD_ROOT_PASSWORD=
FLUXER_HA_ETCD_PATRONI_PASSWORD=
FLUXER_HA_VALKEY_PASSWORD=
# How every Fluxer service reaches Valkey; Compose fills in the password.
FLUXER_KV_URL=redis://:${FLUXER_HA_VALKEY_PASSWORD}@valkey:6379/0

# --- Public name and DNS failover ---
FLUXER_HA_DNS_NAME=chat.example.com
FLUXER_HA_DNS_TTL=60
# cloudflare | exec | none   (docs/dns.md)
FLUXER_HA_DNS_PROVIDER=cloudflare
# Resolver the health checks ask, standing in for "what users see".
FLUXER_HA_DNS_CHECK_RESOLVER=1.1.1.1
# cloudflare: a token with Zone.DNS:Edit on this one zone; the record must be
# DNS-only (grey cloud). Find the IDs with the API or the dashboard.
FLUXER_HA_CF_API_TOKEN=
FLUXER_HA_CF_ZONE_ID=
FLUXER_HA_CF_RECORD_ID_A=
FLUXER_HA_CF_RECORD_ID_AAAA=
# exec: an executable, root-owned, called as <hook> <name> <A|AAAA> <ip> <ttl>
FLUXER_HA_DNS_HOOK=

# --- Certificates (docs/reverse-proxies.md) ---
# edge   upstream's bundled edge (install.sh --tls bundled, the default)
# caddy  your own Caddy container: also set the two lines below
# none   you handle certificates on both sites yourself
FLUXER_HA_CERT_MODE=edge
FLUXER_HA_CADDY_DATA_VOLUME=
FLUXER_HA_CADDY_CONTAINER=
# Your proxy's Docker network, if it's a container (compose/ha.proxy-network.yml).
FLUXER_HA_PROXY_NETWORK=

# --- Monitoring (docs/operations.md, "Monitoring") ---
# A dead-man's-switch URL (healthchecks.io, Uptime Kuma push, ...): pinged by
# the replica only while automatic failover is possible.
FLUXER_HA_HEARTBEAT_URL=
# Gets a POST with a one-line message on every role change and failure.
FLUXER_HA_ALERT_URL=

# --- Automatic failback (docs/architecture.md, "Failback"). Defaults. ---
FLUXER_HA_PREFERRED_SITE=site1
FLUXER_HA_FAILBACK_ENABLED=true
FLUXER_HA_FAILBACK_STABLE_SECONDS=3600
FLUXER_HA_FAILBACK_RETRY_SECONDS=21600
FLUXER_HA_FAILBACK_MAX_RETRY_SECONDS=604800
FLUXER_HA_FAILBACK_RELAPSE_SECONDS=86400
FLUXER_HA_FAILBACK_MAX_STABLE_SECONDS=86400
FLUXER_HA_FAILBACK_JOBS_WAIT_SECONDS=1800
# Optional local-hour window for the switchover, e.g. 2-6. Empty: any time.
FLUXER_HA_FAILBACK_HOURS=

# --- Media mirror tuning. Defaults. ---
FLUXER_HA_S3_MIRROR_INTERVAL_SECONDS=3600
FLUXER_HA_S3_MIRROR_MAX_DELETE=200
# A copy has no time limit. An rclone run is stopped after this many seconds
# WITHOUT PROGRESS; one object that makes none for the second is skipped as
# unreadable (operations.md, "s3-mirror stops, or skips objects").
FLUXER_HA_S3_MIRROR_STALL_SECONDS=300
FLUXER_HA_S3_MIRROR_OBJECT_STALL_SECONDS=60
