# fluxer-ha: .env.site, this host only. `fluxer-ha init` writes one per site.
# Nothing here says which site is primary; Patroni decides.

# Bundled TLS:        docker-compose.yml:ha.compose.yml
# Your own proxy:     docker-compose.yml:docker-compose.proxy.yml[:ha.proxy-network.yml]:ha.compose.yml
# Optional pinning:   append :ha.images.lock.yml once it exists on both sites
COMPOSE_FILE=docker-compose.yml:ha.compose.yml

FLUXER_HA_SITE=site1
FLUXER_HA_PEER_SITE=site2
FLUXER_HA_LOCAL_WG_IP=10.77.0.1
FLUXER_HA_PEER_WG_IP=10.77.0.2
FLUXER_HA_PEER_SSH=fluxer-ha@10.77.0.2

# This site's public addresses go into DNS when it becomes primary; the
# peer's is what the health check expects DNS to show while this is the replica.
FLUXER_HA_PUBLIC_IPV4=203.0.113.10
FLUXER_HA_PUBLIC_IPV6=
FLUXER_HA_PEER_PUBLIC_IPV4=198.51.100.20

# Advertised to WebRTC clients: this site's public IPv4.
FLUXER_LIVEKIT_NODE_IP=203.0.113.10

# Snowflake worker ID: site1 keeps the stock worker 0; site2 is shard 1 of 2
# and its API and worker ask shard 1 directly, so the sites never mint the
# same ID (docs/architecture.md, "Snowflake IDs").
FLUXER_HA_SNOWFLAKE_WORKER_ID=0
FLUXER_HA_SNOWFLAKE_SHARD_COUNT=1
FLUXER_HA_SNOWFLAKE_SUBJECT=svc.snowflakes
# site2: FLUXER_HA_SNOWFLAKE_WORKER_ID=1, _SHARD_COUNT=2, _SUBJECT=svc.snowflakes.shard.1
